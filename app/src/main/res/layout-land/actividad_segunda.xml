<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA"
    android:orientation="vertical"
    tools:context=".SegundoEjercicio">

    <!-- Barra superior verde -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="#00897B"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="thollererChangeMaker"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            tools:ignore="HardcodedText" />
    </LinearLayout>

    <!-- Contenedor principal horizontal: Izquierda (Denominaciones) / Derecha (Teclado) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- Columna Izquierda: Precio y Denominaciones -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="Price:  2.34"
                android:textColor="#333333"
                android:textSize="18sp"
                tools:ignore="HardcodedText" />

            <!-- Denominaciones en dos columnas internas -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginEnd="24dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="$20:  0" android:textSize="14sp" android:textColor="#424242" android:layout_marginBottom="6dp" tools:ignore="HardcodedText" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="$10:  0" android:textSize="14sp" android:textColor="#424242" android:layout_marginBottom="6dp" tools:ignore="HardcodedText" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="  $5:  0" android:textSize="14sp" android:textColor="#424242" android:layout_marginBottom="6dp" tools:ignore="HardcodedText" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="  $1:  2" android:textSize="14sp" android:textColor="#424242" tools:ignore="HardcodedText" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="25c:  1" android:textSize="14sp" android:textColor="#424242" android:layout_marginBottom="6dp" tools:ignore="HardcodedText" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="10c:  0" android:textSize="14sp" android:textColor="#424242" android:layout_marginBottom="6dp" tools:ignore="HardcodedText" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="  5c:  1" android:textSize="14sp" android:textColor="#424242" android:layout_marginBottom="6dp" tools:ignore="HardcodedText" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="  1c:  4" android:textSize="14sp" android:textColor="#424242" tools:ignore="HardcodedText" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- Columna Derecha: Teclado Numérico -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <GridLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:columnCount="4"
                android:rowCount="3"
                android:alignmentMode="alignMargins">

                <Button android:layout_width="50dp" android:layout_height="44dp" android:layout_margin="2dp" android:text="1" android:textSize="13sp" android:textColor="#333333" android:backgroundTint="#E0E0E0" tools:ignore="HardcodedText" />
                <Button android:layout_width="50dp" android:layout_height="44dp" android:layout_margin="2dp" android:text="2" android:textSize="13sp" android:textColor="#333333" android:backgroundTint="#E0E0E0" tools:ignore="HardcodedText" />
                <Button android:layout_width="50dp" android:layout_height="44dp" android:layout_margin="2dp" android:text="3" android:textSize="13sp" android:textColor="#333333" android:backgroundTint="#E0E0E0" tools:ignore="HardcodedText" />
                <Button android:layout_width="50dp" android:layout_height="44dp" android:layout_margin="2dp" android:text="4" android:textSize="13sp" android:textColor="#333333" android:backgroundTint="#E0E0E0" tools:ignore="HardcodedText" />

                <Button android:layout_width="50dp" android:layout_height="44dp" android:layout_margin="2dp" android:text="5" android:textSize="13sp" android:textColor="#333333" android:backgroundTint="#E0E0E0" tools:ignore="HardcodedText" />
                <Button android:layout_width="50dp" android:layout_height="44dp" android:layout_margin="2dp" android:text="6" android:textSize="13sp" android:textColor="#333333" android:backgroundTint="#E0E0E0" tools:ignore="HardcodedText" />
                <Button android:layout_width="50dp" android:layout_height="44dp" android:layout_margin="2dp" android:text="7" android:textSize="13sp" android:textColor="#333333" android:backgroundTint="#E0E0E0" tools:ignore="HardcodedText" />
                <Button android:layout_width="50dp" android:layout_height="44dp" android:layout_margin="2dp" android:text="8" android:textSize="13sp" android:textColor="#333333" android:backgroundTint="#E0E0E0" tools:ignore="HardcodedText" />

                <Button android:layout_width="50dp" android:layout_height="44dp" android:layout_margin="2dp" android:text="9" android:textSize="13sp" android:textColor="#333333" android:backgroundTint="#E0E0E0" tools:ignore="HardcodedText" />
                <Button android:layout_width="50dp" android:layout_height="44dp" android:layout_margin="2dp" android:text="0" android:textSize="13sp" android:textColor="#333333" android:backgroundTint="#E0E0E0" tools:ignore="HardcodedText" />
                <Button android:layout_width="104dp" android:layout_height="44dp" android:layout_columnSpan="2" android:layout_margin="2dp" android:text="CLEAR" android:textSize="11sp" android:textColor="#333333" android:backgroundTint="#E0E0E0" tools:ignore="HardcodedText" />

            </GridLayout>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
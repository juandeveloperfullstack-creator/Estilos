<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA"
    android:orientation="vertical"
    tools:context=".ActividadSiete">

    <!-- Barra superior verde teal -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#00897B"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:elevation="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/room_demo_title"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Contenedor del Formulario -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Product ID -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="140dp"
                android:layout_height="wrap_content"
                android:text="@string/label_product_id"
                android:textColor="#666666"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/value_not_assigned"
                android:textColor="#666666"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Product Name -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="140dp"
                android:layout_height="wrap_content"
                android:text="@string/label_product_name"
                android:textColor="#666666"
                android:textSize="15sp" />

            <EditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#999999"
                android:inputType="text"
                android:minHeight="48dp"
                tools:ignore="Autofill,HardcodedText" />
        </LinearLayout>

        <!-- Product Quantity -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="140dp"
                android:layout_height="wrap_content"
                android:text="@string/label_product_quantity"
                android:textColor="#666666"
                android:textSize="15sp" />

            <EditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#999999"
                android:inputType="number"
                android:minHeight="48dp"
                tools:ignore="Autofill,HardcodedText" />
        </LinearLayout>

        <!-- Botones de Acción (ADD, DELETE, FIND) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="24dp">

            <Button
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_add"
                android:textColor="#222222"
                android:textStyle="bold" />

            <Button
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_delete"
                android:textColor="#222222"
                android:textStyle="bold" />

            <Button
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_find"
                android:textColor="#222222"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

    <!-- Lista de elementos inferiores (Items) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Item 0" android:textColor="#666666" android:textSize="14sp" android:paddingVertical="4dp" tools:ignore="HardcodedText" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Item 1" android:textColor="#666666" android:textSize="14sp" android:paddingVertical="4dp" tools:ignore="HardcodedText" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Item 2" android:textColor="#666666" android:textSize="14sp" android:paddingVertical="4dp" tools:ignore="HardcodedText" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Item 3" android:textColor="#666666" android:textSize="14sp" android:paddingVertical="4dp" tools:ignore="HardcodedText" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Item 4" android:textColor="#666666" android:textSize="14sp" android:paddingVertical="4dp" tools:ignore="HardcodedText" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Item 5" android:textColor="#666666" android:textSize="14sp" android:paddingVertical="4dp" tools:ignore="HardcodedText" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Item 6" android:textColor="#666666" android:textSize="14sp" android:paddingVertical="4dp" tools:ignore="HardcodedText" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Item 7" android:textColor="#666666" android:textSize="14sp" android:paddingVertical="4dp" tools:ignore="HardcodedText" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Item 8" android:textColor="#666666" android:textSize="14sp" android:paddingVertical="4dp" tools:ignore="HardcodedText" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Item 9" android:textColor="#666666" android:textSize="14sp" android:paddingVertical="4dp" tools:ignore="HardcodedText" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
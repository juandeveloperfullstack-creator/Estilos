<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp"
    tools:context=".ActividadCatorce">

    <!-- Pregunta de la encuesta -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:text="¿Cuál es tu área de desarrollo favorita?"
        android:textColor="#333333"
        android:textSize="18sp"
        android:textStyle="bold"
        tools:ignore="HardcodedText" />

    <!-- Grupo de opciones -->
    <RadioGroup
        android:id="@+id/radioGroupSurvey"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp">

        <RadioButton
            android:id="@+id/radioBackend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="Backend (PHP / Laravel)"
            android:textSize="16sp"
            tools:ignore="HardcodedText" />

        <RadioButton
            android:id="@+id/radioFrontend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="Frontend (React / Web)"
            android:textSize="16sp"
            tools:ignore="HardcodedText" />

        <RadioButton
            android:id="@+id/radioMobile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="Desarrollo Móvil (Android / Kotlin)"
            android:textSize="16sp"
            tools:ignore="HardcodedText" />

        <RadioButton
            android:id="@+id/radioDatabase"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bases de Datos (MySQL / MongoDB)"
            android:textSize="16sp"
            tools:ignore="HardcodedText" />

    </RadioGroup>

    <!-- Botón Enviar -->
    <Button
        android:id="@+id/btnSubmitSurvey"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="#3F51B5"
        android:text="Enviar"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        tools:ignore="HardcodedText" />

</LinearLayout>
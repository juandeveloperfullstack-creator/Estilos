<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF8FC"
    android:orientation="vertical"
    tools:context=".TercerEjercicio">

    <!-- Barra superior verde -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="#00897B"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_bar"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Contenido en dos columnas -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="20dp">

        <!-- Columna Izquierda: Raised Button -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingEnd="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:text="@string/raised_button"
                android:textColor="#555555"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Botón Raised Normal -->
            <Button
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="16dp"
                android:backgroundTint="#00BFA5"
                android:text="@string/btn_normal"
                android:textColor="#FFFFFF" />

            <!-- Botón Raised Pressed (simulado con color activo) -->
            <Button
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="16dp"
                android:backgroundTint="#00897B"
                android:text="@string/btn_pressed"
                android:textColor="#FFFFFF" />

            <!-- Botón Raised Disabled -->
            <Button
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:backgroundTint="#00BFA5"
                android:enabled="false"
                android:text="@string/btn_disabled"
                android:textColor="#FFFFFF" />

        </LinearLayout>

        <!-- Columna Derecha: Flat Button -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:text="@string/flat_button"
                android:textColor="#555555"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Botón Flat Normal -->
            <Button
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="16dp"
                android:text="@string/btn_normal"
                android:textColor="#00BFA5" />

            <!-- Botón Flat Pressed -->
            <Button
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="16dp"
                android:text="@string/btn_pressed"
                android:textColor="#00897B" />

            <!-- Botón Flat Disabled -->
            <Button
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:enabled="false"
                android:text="@string/btn_disabled"
                android:textColor="#AAAAAA" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
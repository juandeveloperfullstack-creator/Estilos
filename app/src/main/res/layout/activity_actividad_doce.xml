<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".ActividadDoce">

    <!-- Pantalla de la calculadora -->
    <TextView
        android:id="@+id/textScreen"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_marginBottom="16dp"
        android:background="#FFFFFF"
        android:gravity="end|bottom"
        android:padding="16dp"
        android:text="0"
        android:textColor="#000000"
        android:textSize="48sp"
        android:textStyle="bold"
        tools:ignore="HardcodedText" />

    <!-- Botones: Fila 1 (7, 8, 9, /) -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:weightSum="4">
        <Button android:id="@+id/btn7" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="7" android:textSize="24sp" tools:ignore="HardcodedText"/>
        <Button android:id="@+id/btn8" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="8" android:textSize="24sp" tools:ignore="HardcodedText"/>
        <Button android:id="@+id/btn9" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="9" android:textSize="24sp" tools:ignore="HardcodedText"/>
        <Button android:id="@+id/btnDiv" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="/" android:textSize="24sp" android:backgroundTint="#FF9800" tools:ignore="HardcodedText"/>
    </LinearLayout>

    <!-- Botones: Fila 2 (4, 5, 6, *) -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:weightSum="4">
        <Button android:id="@+id/btn4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="4" android:textSize="24sp" tools:ignore="HardcodedText"/>
        <Button android:id="@+id/btn5" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="5" android:textSize="24sp" tools:ignore="HardcodedText"/>
        <Button android:id="@+id/btn6" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="6" android:textSize="24sp" tools:ignore="HardcodedText"/>
        <Button android:id="@+id/btnMul" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="*" android:textSize="24sp" android:backgroundTint="#FF9800" tools:ignore="HardcodedText"/>
    </LinearLayout>

    <!-- Botones: Fila 3 (1, 2, 3, -) -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:weightSum="4">
        <Button android:id="@+id/btn1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="1" android:textSize="24sp" tools:ignore="HardcodedText"/>
        <Button android:id="@+id/btn2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="2" android:textSize="24sp" tools:ignore="HardcodedText"/>
        <Button android:id="@+id/btn3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="3" android:textSize="24sp" tools:ignore="HardcodedText"/>
        <Button android:id="@+id/btnMin" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="-" android:textSize="24sp" android:backgroundTint="#FF9800" tools:ignore="HardcodedText"/>
    </LinearLayout>

    <!-- Botones: Fila 4 (C, 0, =, +) -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:weightSum="4">
        <Button android:id="@+id/btnClear" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="C" android:textSize="24sp" android:backgroundTint="#D32F2F" tools:ignore="HardcodedText"/>
        <Button android:id="@+id/btn0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="0" android:textSize="24sp" tools:ignore="HardcodedText"/>
        <Button android:id="@+id/btnEqual" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="=" android:textSize="24sp" android:backgroundTint="#4CAF50" tools:ignore="HardcodedText"/>
        <Button android:id="@+id/btnPlus" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="+" android:textSize="24sp" android:backgroundTint="#FF9800" tools:ignore="HardcodedText"/>
    </LinearLayout>

</LinearLayout>